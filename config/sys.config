[
    {mdns, [
        %% Interface to join the mDNS multicast group on: an interface
        %% name (e.g. "eth0"), a literal IPv4 address, or `undefined` to
        %% auto-pick the first non-loopback IPv4 interface (fine for
        %% dev/single-NIC boxes; set explicitly on multi-homed hosts).
        {interface, undefined},

        %% Classic unicast-DNS bridge for `.local`.
        {dns_port, 8053},
        {dns_bind_ip, {0, 0, 0, 0}},

        %% Cap on the TTL handed back over the classic-DNS bridge, so an
        %% upstream forwarder doesn't cache us into staleness.
        {answer_ttl, 30},

        %% How long to wait for an on-demand mDNS answer on a cache miss
        %% before replying NXDOMAIN.
        {query_timeout_ms, 400}
    ]}
].
