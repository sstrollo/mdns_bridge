[
    {mdns_bridge, [
        %% Interface to join the mDNS multicast group on: an interface
        %% name (e.g. "eth0"), a literal IPv4 address, or `undefined` to
        %% auto-pick the first non-loopback IPv4 interface (fine for
        %% dev/single-NIC boxes; set explicitly on multi-homed hosts).
        {interface, undefined},

        %% Classic unicast-DNS bridge for `.local`.
        {dns_port, 8053},
        {dns_bind_ip, {0, 0, 0, 0}},

        %% Cap on the TTL handed back over the classic-DNS bridge, so an
        %% upstream forwarder doesn't cache us into staleness.
        {answer_ttl, 30},

        %% How long to wait for an on-demand mDNS answer on a cache miss
        %% before replying NXDOMAIN.
        {query_timeout_ms, 400},

        %% Cap on how many classic-DNS bridge requests are acted on per
        %% second; the rest are dropped like a lost UDP packet. Bounds
        %% how much this port can be used to spawn processes or trigger
        %% outbound mDNS queries against whoever can reach it. `infinity`
        %% disables the limit.
        {dns_rate_limit_per_second, 1000},

        %% TTL announced for names registered via mdns:register/2,3.
        {publish_ttl, 120},

        %% How often to re-announce every currently registered name, so
        %% caches elsewhere on the network don't let it expire.
        {publish_reannounce_ms, 60000},

        %% Cap on distinct records learned from the network. Once over
        %% it, the oldest entries are evicted to make room - bounds
        %% memory use against a noisy or adversarial network.
        {cache_max_entries, 10000}
    ]}
].
