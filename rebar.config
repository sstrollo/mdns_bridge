{erl_opts, [debug_info]}.
{deps, []}.

{shell, [
    {config, "config/sys.config"},
    {apps, [mdns_bridge]}
]}.

{plugins, [erlfmt]}.
{project_plugins, [rebar3_ex_doc]}.

{erlfmt, [
    write,
    {print_width, 100},
    {files, ["src/*.erl", "include/*.hrl", "test/*.erl", "rebar.config"]}
]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"LICENSE.md", #{title => "License"}}
    ]},
    {main, "README.md"},
    {source_url, "https://github.com/sstrollo/mdns_bridge"}
]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [kernel, stdlib]}
]}.
